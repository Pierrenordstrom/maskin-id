# Datakälla: "mock" (exempeldata i webbläsaren) eller "supabase".
VITE_DATA_SOURCE=mock

# Fylls i när Supabase-projektet finns (Project Settings → API).
# Använd publishable/anon key – ALDRIG service role key i frontend.
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
